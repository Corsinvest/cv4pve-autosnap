<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<OutputType>Library</OutputType>
		<Product>Corsinvest for Proxmox VE Auto Snapshot Api</Product>
		<AssemblyTitle>Corsinvest for Proxmox VE Auto Snapshot Api</AssemblyTitle>
		<Description>Auto Snapshot API library for Proxmox VE: scheduled VM/LXC snapshots with retention</Description>
		<PackageTags>ProxmoxVE;Api;Client;Rest;Corsinvest;AutoSnap</PackageTags>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

		<!-- Local test feed: every build drops the package in ProxmoxVE\.nupkgs -->
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageOutputPath>..\..\..\.nupkgs\</PackageOutputPath>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>

		<!-- Symbols: PDB inside the .nupkg (local debugging) and .snupkg for nuget.org -->
		<AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\icon.png" Pack="true" PackagePath="" />
		<None Include="..\..\README.md" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Corsinvest.ProxmoxVE.AutoSnap.Api.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Corsinvest.ProxmoxVE.Api.Extension" />
	</ItemGroup>
</Project>